# Copia este archivo a .env y rellena solo lo que vayas a usar. Nunca subas .env al repositorio.
# Ninguna de estas variables llega al navegador: solo las lee el servidor (server/env.ts).

# ───────────── Servidor ─────────────
# Puerto de la API (en desarrollo Vite redirige /api a este puerto).
API_PORT=8787
# URL pública de la web: URLs de retorno de Stripe, enlaces de los emails, sitemap, canonical y CSRF.
PUBLIC_URL=http://localhost:5173
# Ruta del archivo SQLite (se crea automáticamente).
DATABASE_PATH=./data/hypsos.db
# Solo detrás de un proxy propio (Nginx, Render, Fly…): usar X-Forwarded-For para la IP del cliente.
TRUST_PROXY=false
# Multiplicador de los límites de peticiones por IP. 1 en producción (las pruebas E2E usan 50).
RATE_LIMIT_SCALE=1

# ───────────── Pagos (Stripe) ─────────────
# Sin estas claves la tienda NO procesa pagos: el checkout responde que los pagos
# no están configurados y no se crea ningún pedido.
# Claves en https://dashboard.stripe.com/apikeys (usa las de modo test primero).
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook: stripe listen --forward-to localhost:8787/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ───────────── Email (Resend) ─────────────
# Sin clave no se envía ningún email en producción (en desarrollo se escriben en la consola):
# la recuperación de contraseña indica que no está disponible y no se fingen envíos.
RESEND_API_KEY=
# Remitente verificado en el proveedor, p. ej. "HYPSOS <pedidos@tu-dominio.com>".
MAIL_FROM=
# Buzón que recibe una copia de los mensajes del formulario de contacto.
CONTACT_INBOX=

# ───────────── Analítica (opcional, solo con consentimiento) ─────────────
# Con alguno de estos valores aparece el banner de cookies; sin ellos no se carga nada de terceros.
PLAUSIBLE_DOMAIN=
GA4_MEASUREMENT_ID=
