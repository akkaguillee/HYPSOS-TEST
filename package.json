{
  "name": "hypsos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HYPSOS — web de marca y tienda online de streetwear",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c white,red \"vite\" \"pnpm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && pnpm build:api && tsx scripts/generate-sitemap.ts",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "assets:brand": "node scripts/process-brand-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.5",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "stripe": "^23.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.18.0",
    "vitest": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/user-event": "^14.6.1",
    "@playwright/test": "1.56.1",
    "@axe-core/playwright": "^4.11.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.25.10",
    "sharp": "^0.35.5",
    "concurrently": "^9.2.0",
    "eslint": "^9.36.0",
    "@eslint/js": "^9.36.0",
    "typescript-eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
